#!/bin/sh
# agyask — the normal way to call agy non-interactively.
#
# Installed to ~/.local/bin by install.sh. Two things it guarantees:
#
# 1. Output actually arrives. Upstream bug #76 drops agy's stdout in non-TTY
#    contexts, but only while stdin stays an open pipe, so stdin comes from
#    /dev/null and no PTY is needed. agy_pty_wrapper.py remains the fallback
#    for platforms where the direct path still returns nothing.
#
# 2. agy cannot act. `--mode plan` blocks edits and `--sandbox` restricts
#    terminal use, so prompt text carrying instructions (review payloads are
#    untrusted input) cannot turn into tool calls. There is deliberately no
#    write-enabled path here: babel only ever asks agy for opinions.
#
# Runs outside the Claude Code sandbox via sandbox.excludedCommands
# ("agyask" + "agyask *") — agy needs a localhost bind and, as a Go binary on
# darwin, cannot verify TLS through the sandbox proxy. Renaming this script
# means updating that list. See SKILL.md.
#
# AGY_PRINT_TIMEOUT is the total budget for the call, in seconds ("180s").
set -eu

BUDGET="${AGY_PRINT_TIMEOUT:-180s}"
# Stripping non-digits alone read "3m" as 3 seconds — a Go-style duration the agy
# docs themselves use — and killed agy before it could answer. Accept s/m/h, and
# refuse a budget under 10s rather than starting a call the watchdog will shoot
# on its first check.
budget_num=${BUDGET%[smh]}
case "$BUDGET" in
  *[0-9]h) budget_unit=h ;;
  *[0-9]m) budget_unit=m ;;
  *[0-9]s) budget_unit=s ;;
  *[0-9])  budget_unit=s ;;
  *)       budget_unit=bad ;;
esac
# Validate the number before any arithmetic: "1h30m" strips to "1h30", and the old
# digit-scraping parse turned it into 130 minutes — a bound the caller never asked
# for, applied silently.
case "$budget_num" in ''|*[!0-9]*) budget_unit=bad ;; esac
case "$budget_unit" in
  h) budget_secs=$(( budget_num * 3600 )) ;;
  m) budget_secs=$(( budget_num * 60 )) ;;
  s) budget_secs=$budget_num ;;
  *) printf 'agyask: AGY_PRINT_TIMEOUT=%s is not a plain <number>[s|m|h] — refusing to guess a bound (compound forms like 1h30m are not supported).\n' "$BUDGET" >&2
     exit 3 ;;
esac
if [ "$budget_secs" -lt 10 ]; then
  printf 'agyask: AGY_PRINT_TIMEOUT=%s is under the 10s floor — refusing to start a call that would be killed immediately.\n' "$BUDGET" >&2
  exit 3
fi

# One line on stderr, before the call, naming when this call must be over. The
# watchdog below already bounds the call; what this adds is a bound the CALLER can
# read. A lead waiting on a background job has no clock and gets no notification
# from a wedged shim, so "past its bound" is a condition it can otherwise never
# evaluate (protocol.md §8). stdout stays the findings channel, untouched.
printf 'BABEL_DEADLINE {"provider":"agy","cap_s":%s,"deadline":%s,"pid":%s}\n' \
  "$budget_secs" "$(( $(date +%s) + budget_secs ))" "$$" >&2

# Print/headless agy aborts the entire run when a tool needs a permission it
# cannot prompt for ("no output produced — a tool required the <x> permission
# that headless mode cannot prompt for"), and the allow-list in
# ~/.gemini/antigravity-cli/settings.json is path-specific, so any prompt that
# makes agy reach for a file or a command outside those paths returns nothing.
# Measured on the same 4.4KB review prompt: without this directive, empty after
# 52s (direct + PTY fallback both denied); with it, 3 findings in 23s. The babel
# templates already appended it by hand — doing it here instead means no caller
# can forget. Set AGY_TOOLS=1 to opt out; then the permission the prompt needs
# must already exist in that settings file, or the call comes back empty.
prompt=$*
# An empty payload must not become a call. Without this the whole prompt is the
# appended no-tools sentence, agy acknowledges it, and the caller gets a
# non-empty exit-0 answer about nothing reviewed (protocol.md §4, void round).
# A byte floor as well as an emptiness check: `tr -d '[:space:]'` is ASCII-only,
# so a payload of nothing but U+00A0 or U+3000 would pass an emptiness test while
# containing no review payload at all. No real prompt is under 20 bytes.
if [ "$(printf '%s' "$prompt" | tr -d '[:space:]' | wc -c | tr -d ' ')" -lt 20 ]; then
  printf 'agyask: refusing a prompt with almost no content — nothing would be reviewed and the reply would still look clean.\n' >&2
  exit 3
fi
if [ "${AGY_TOOLS:-0}" != "1" ]; then
  prompt="$prompt

Do not use any tools — answer directly from the text given above."
fi
# The workspace agy is shown. `--mode plan --sandbox` stop edits and commands, but
# reads under --add-dir stay permitted, and the no-tools sentence above is an
# instruction, not a control: a hostile hunk could ask agy to read $PWD/.env and
# quote it back. So the workspace is an EMPTY directory unless the caller opted
# into tools with AGY_TOOLS=1 — agy still needs some workspace ("No active
# workspace is set." otherwise), it just gets one with nothing in it.
if [ "${AGY_TOOLS:-0}" = "1" ]; then
  AGY_DIR=$PWD
else
  AGY_DIR=$(mktemp -d "${TMPDIR:-/tmp}/agyask-ws.XXXXXX") || exit 3
fi

# Resolve agy to a path we choose, not to whatever PATH happens to name. agyask
# runs OUTSIDE the Claude Code sandbox (sandbox.excludedCommands), so an `agy`
# planted earlier on PATH would execute unsandboxed with the user's full access.
# Same resolution order as agy_pty_wrapper.py.
AGY_BIN=""
# An AGY_PATH that is set but not executable is a typo or a bad install, not a
# request to fall back: silently using a different binary than the one the caller
# pinned is exactly the substitution this resolution order exists to prevent.
if [ -n "${AGY_PATH:-}" ] && [ ! -x "${AGY_PATH}" ]; then
  printf 'agyask: AGY_PATH is set to "%s" but that is not an executable file. Fix it or unset it.\n' "$AGY_PATH" >&2
  exit 3
fi
for _c in "${AGY_PATH:-}" "$HOME/.local/bin/agy" "$HOME/.antigravity/bin/agy" /usr/local/bin/agy /opt/homebrew/bin/agy; do
  [ -n "$_c" ] && [ -x "$_c" ] && { AGY_BIN=$_c; break; }
done
if [ -z "$AGY_BIN" ]; then
  printf 'agyask: agy not found in a known location. Install it, or set AGY_PATH to its absolute path (PATH is deliberately not searched: this shim runs outside the sandbox).\n' >&2
  exit 3
fi

# Usage reporting (BABEL_USAGE on stderr) needs a JSON parser, because agy only
# reports its token spend under --output-format json and the answer text then
# arrives inside an envelope that sh cannot safely take apart (the response field
# carries newlines and quotes). Resolve the same venv interpreter the PTY fallback
# uses — and *only* that one. The fallback's last resort is a bare `python3` off
# PATH, which is acceptable there because the fallback is already a degraded path;
# hoisting a PATH lookup onto the primary answer path of a sandbox-excluded shim
# would let a planted `python3` read every prompt babel sends. No venv, no JSON
# mode: the call runs exactly as it did before and the round reports tokens: null,
# which is the documented correct outcome for an unavailable usage record.
USAGE_PY="$HOME/.local/share/babel/agy-venv/bin/python3"
[ -x "$USAGE_PY" ] || USAGE_PY="$HOME/.local/share/babel/agy-venv/Scripts/python.exe"
# With the venv present the prompt travels on STDIN as one stream-json message,
# not as an argv element (measured on agy 1.1.23: 3/3 stable, a 40 KB prompt
# accepted, stdout intact despite upstream #76 — the message is written whole and
# stdin closed before agy starts reading). That removes the `ps` exposure and the
# ARG_MAX ceiling of the argv form. The reply is a stream of events; the parser
# below takes the final `result` event, whose body is the same envelope
# `--output-format json` returns.
# AGY_SCHEMA=<json-schema file> adds --json-schema and prints the envelope's
# `structured_output` (clean JSON) instead of `response` (which under a schema
# comes back as a fenced blob plus a raw copy — measured, not usable as text).
if [ -x "$USAGE_PY" ]; then AGY_JSON_ARGS="--input-format stream-json --output-format stream-json"; else AGY_JSON_ARGS=""; fi
if [ -n "${AGY_SCHEMA:-}" ]; then
  if [ -z "$AGY_JSON_ARGS" ]; then
    printf 'agyask: AGY_SCHEMA needs the agy venv python (structured output arrives inside a JSON envelope). Run install.sh.\n' >&2
    exit 3
  fi
  if [ ! -r "$AGY_SCHEMA" ]; then
    printf 'agyask: AGY_SCHEMA=%s is not a readable file.\n' "$AGY_SCHEMA" >&2
    exit 3
  fi
  AGY_JSON_ARGS="$AGY_JSON_ARGS --json-schema $AGY_SCHEMA"
fi

started=$(date +%s)
# The budget is enforced here, not delegated. Two reasons it cannot be delegated:
# agy's own --print-timeout never engages when agy wedges before starting its
# timer (print/headless mode stalling on an MCP-tool confirmation), and the
# caller's Bash `timeout:` does not apply to a `run_in_background` job at all —
# measured, not assumed. Without this watchdog a wedged agy blocks forever and
# the caller waits for a completion notification that never arrives. `timeout(1)`
# is not present on stock macOS, hence the hand-rolled wait loop.
# Kills the whole descendant tree, not just the direct child: agy spawns a
# language-server process of its own, and killing only the pid we hold left that
# grandchild running under init — the accumulation that eventually surfaced as
# "out of pty devices". setsid is not on stock macOS, so walk the tree with
# pgrep instead (children first, so nothing re-parents away mid-walk).
# Depth-first: collect descendants before signalling, so a killed parent cannot
# orphan a child we have not recorded yet.
kill_tree() {
  # Signal via $1, never a variable: POSIX sh functions have no local scope, so a
  # recursive call overwrote a shared `_pid` and every non-leaf — agy itself
  # included — was skipped while the last leaf was signalled twice. Positional
  # parameters ARE per-invocation, which is what makes this recursion safe.
  for _k in $(pgrep -P "$1" 2>/dev/null || :); do kill_tree "$_k"; done
  kill -TERM "$1" 2>/dev/null || :
  # A SIGSTOPped process leaves TERM pending forever; CONT lets it run far enough
  # to die. Harmless for a process that was never stopped.
  kill -CONT "$1" 2>/dev/null || :
}

# Escalation for the timeout path: same walk, SIGKILL, which no handler can defer.
kill_tree_hard() {
  for _k in $(pgrep -P "$1" 2>/dev/null || :); do kill_tree_hard "$_k"; done
  kill -KILL "$1" 2>/dev/null || :
}

# The KILL walk re-discovers children with pgrep -P, which only sees processes
# whose parent is still the one we are walking. A child that outlives its parent
# during the TERM grace is reparented to PID 1 and becomes invisible to that walk,
# so it never gets SIGKILL. Snapshot the tree while it is still intact and kill
# the snapshot too. (Accepted, as elsewhere in this file: a pid recycled inside
# the grace window would be signalled by mistake.)
descendants() {
  for _d in $(pgrep -P "$1" 2>/dev/null || :); do descendants "$_d"; printf '%s ' "$_d"; done
}

# Every walk above hides pgrep's own failure behind `2>/dev/null || :`, which is
# right for "this pid has no children" and wrong for "pgrep is missing or cannot
# read the process table" — the second silently degrades tree cleanup to killing
# the direct child while the run still reports an ordinary timeout. Say so once.
# (Measured case: inside the Claude Code sandbox pgrep fails with "Cannot get
# process list", which is exactly why these shims are sandbox-excluded.)
if ! pgrep -P $$ >/dev/null 2>&1 && ! pgrep -l -P 1 >/dev/null 2>&1; then
  printf 'agyask: pgrep cannot read the process table here — on a timeout only the direct agy child is killed, its descendants survive. Cleanup is degraded for this run.\n' >&2
fi

rc=0
killed=0
agy_out=$(mktemp "${TMPDIR:-/tmp}/agyask.XXXXXX") || exit 3
agy_err=$(mktemp "${TMPDIR:-/tmp}/agyask-err.XXXXXX") || { rm -f "$agy_out"; exit 3; }
# Covers a signal landing on agyask itself. The explicit `rm -f`s below still
# matter: the PTY fallback ends in `exec`, which never runs an EXIT trap. INT and
# TERM exit rather than falling through: a POSIX trap handler returns to where it
# left off, and resuming after the temp files are gone means `cat "$agy_err"`
# fails under `set -e` and the diagnostics are lost instead of replayed.
# INT/TERM also kill the agy child: the shim exiting does not reap it, and an agy
# left running under a dead parent is the orphan that later shows up as "out of
# pty devices". `${agy_pid:-}` because the traps are armed before the spawn.
# The empty workspace is removed too; `ws_rm` is a no-op when the workspace is $PWD.
ws_rm() { [ "$AGY_DIR" != "$PWD" ] && rmdir "$AGY_DIR" 2>/dev/null; :; }
trap 'rm -f "$agy_out" "$agy_err"; ws_rm' EXIT
# `${agy_pid:-0}` would have been catastrophic: kill(1) reads 0 as "every process
# in my process group", so a signal arriving before the spawn would have taken the
# caller down with it. Only signal a pid we actually have.
trap '[ -n "${agy_pid:-}" ] && kill_tree "$agy_pid"; rm -f "$agy_out" "$agy_err"; ws_rm; exit 130' INT
trap '[ -n "${agy_pid:-}" ] && kill_tree "$agy_pid"; rm -f "$agy_out" "$agy_err"; ws_rm; exit 143' TERM
# stdout is captured; stderr is captured only to be inspected for the
# permission-abort line and is replayed verbatim afterwards, so agy's own
# diagnostics still reach the caller exactly as they did before.
# $AGY_JSON_ARGS is unquoted on purpose: it is either empty or the fixed tokens
# set above plus an AGY_SCHEMA path the caller chose (so a path with spaces in it
# would split — refuse that rather than quote around it, since the rest of the
# string must stay word-split).
case "${AGY_SCHEMA:-}" in *[[:space:]]*) printf 'agyask: AGY_SCHEMA path must not contain whitespace.\n' >&2; exit 3 ;; esac
if [ -n "$AGY_JSON_ARGS" ]; then
  # One NDJSON message on stdin; -p "" keeps agy in print mode. The message is
  # built by the venv python, the only JSON writer this shim trusts (see above).
  agy_in=$(mktemp "${TMPDIR:-/tmp}/agyask-in.XXXXXX") || exit 3
  printf '%s' "$prompt" | "$USAGE_PY" -c 'import json,sys; print(json.dumps({"event":"user","message":{"role":"user","content":sys.stdin.read()}}))' > "$agy_in"
  # shellcheck disable=SC2086
  "$AGY_BIN" --model "${AGY_MODEL:-gemini-3.7-flash-high}" --mode plan --sandbox --add-dir "$AGY_DIR" --print-timeout "${budget_secs}s" $AGY_JSON_ARGS -p "" < "$agy_in" > "$agy_out" 2> "$agy_err" &
  agy_pid=$!
  rm -f "$agy_in"   # the child holds the descriptor; the name is gone from disk
else
  "$AGY_BIN" --model "${AGY_MODEL:-gemini-3.7-flash-high}" --mode plan --sandbox --add-dir "$AGY_DIR" --print-timeout "${budget_secs}s" -p "$prompt" < /dev/null > "$agy_out" 2> "$agy_err" &
  agy_pid=$!
fi
# Wall clock, not an iteration count: each loop pass costs a kill -0, a sleep and
# scheduler latency, so counting passes overshoots on a loaded host and stalls
# entirely across a suspend — and the PTY fallback below already computes its own
# remaining budget from `date`, so a counter here makes the two disagree.
deadline=$(( started + budget_secs ))
# `date` is CLOCK_REALTIME: a backward step (NTP, manual set) pushes the deadline
# away and the "bound" stops binding. POSIX sh has no monotonic clock, so the
# 1s-sleep loop doubles as one — whichever limit trips first ends the call, and
# the iteration ceiling is generous enough that scheduler latency alone (which
# makes each pass cost slightly more than 1s) never trips it early.
ticks=0
# +60, not ×3: each pass costs slightly more than its 1s sleep, so the counter
# always lags real seconds and needs *some* slack, but a multiplier made the
# backstop three times the advertised budget — on a stepped-back clock, the only
# case where it is load-bearing, a 180s call could run for 540s.
tick_ceiling=$(( budget_secs + 60 ))
while kill -0 "$agy_pid" 2>/dev/null; do
  if [ "$(date +%s)" -ge "$deadline" ] || [ "$ticks" -ge "$tick_ceiling" ]; then
    tree_pids=$(descendants "$agy_pid")
    kill_tree "$agy_pid"
    sleep 2
    kill_tree_hard "$agy_pid"
    for _p in $tree_pids; do kill -KILL "$_p" 2>/dev/null || :; done
    killed=1
    break
  fi
  sleep 1
  ticks=$(( ticks + 1 ))
done
wait "$agy_pid" 2>/dev/null || rc=$?
cat "$agy_err" >&2
# A killed agy's file may already hold a partial answer. Discard it rather than
# printing it: downstream this is parsed as a DesignPacket or finding-jsonl, and
# a truncated one that still exits 0 is indistinguishable from a real answer.
if [ "$killed" -eq 1 ]; then
  printf 'agyask: agy exceeded the %ss budget and was killed; discarding %s bytes of partial output.\n' \
    "$budget_secs" "$(wc -c < "$agy_out" | tr -d ' ')" >&2
  rm -f "$agy_out"
  exit 2
fi
out=$(cat "$agy_out")
rm -f "$agy_out"
# Whitespace-only counts as no answer: a stray newline or a stripped ANSI reset
# would otherwise satisfy a length test and be reported as a completed review.
if [ -z "$(printf '%s' "$out" | tr -d '[:space:]')" ]; then out=""; fi
# Unwrap the envelope BEFORE the "did we get an answer" test below, so an envelope
# carrying an empty answer reaches the PTY fallback exactly as an empty plain-text
# answer always did.
#
# A leading `{` is NOT the discriminator, and that was the first thing wrong here:
# a real review answer *starts* with `{"receipt":…}`, so an agy build that ignored
# --output-format and returned finding-jsonl would be misread as an envelope and
# every valid review would die as a channel failure. Structure decides instead —
# parses as one JSON object carrying a string `response` = envelope; parses
# line-by-line as JSONL = the answer itself; neither = refuse to print it, because
# the one thing that must never happen is an envelope reaching a caller that
# ingests every stdout line as a finding.
if [ -n "$out" ] && [ -n "$AGY_JSON_ARGS" ]; then
  # `if _resp=$(...)` and not a bare assignment: this script runs under `set -e`,
  # where an assignment whose command substitution exits non-zero kills the shell
  # outright — which silently swallowed both non-envelope exits and printed nothing.
  if _resp=$(printf '%s' "$out" | "$USAGE_PY" -c '
import json, sys
def _ok(s):
    # A clean review is the receipt line followed by the literal NONE, which is not
    # JSON. Without this the whole answer fails the JSONL test, and because the
    # receipt makes it start with "{" it would be refused as a truncated envelope —
    # a zero-findings review turned into a channel failure.
    if s.strip() == "NONE":
        return True
    try:
        json.loads(s)
        return True
    except Exception:
        return False
import os
raw = sys.stdin.read().strip()          # .strip(): leading whitespace must not decide this
# stream-json: one event per line; the final `result` event carries the same
# envelope the json format returns. Any other event line is progress, never an
# answer, and must never reach stdout — a caller ingests every line as a finding.
events = []
for l in raw.splitlines():
    try:
        e = json.loads(l)
    except Exception:
        events = None
        break
    if not isinstance(e, dict) or "event" not in e:
        events = None
        break
    events.append(e)
if events:
    results = [e.get("result") for e in events if e.get("event") == "result"]
    if not results or not isinstance(results[-1], dict):
        sys.stderr.write("agyask: stream ended without a result event — agy died mid-stream.\n")
        sys.exit(3)
    j = results[-1]
    raw = json.dumps(j)
try:
    j = json.loads(raw)
except Exception:
    # Not one JSON document. Either finding-jsonl (every line parses), plain text
    # from an agy that ignored the flag, or a truncated envelope. Only the last is
    # refused, and only a leading brace can make it look like one — plain prose
    # must pass through, since that is the pre-change contract.
    lines = [l for l in raw.splitlines() if l.strip()]
    jsonl = bool(lines) and all(_ok(l) for l in lines)
    sys.exit(4 if jsonl or not raw.startswith("{") else 3)
if not isinstance(j, dict) or not isinstance(j.get("response"), str):
    # One object with an agy status/error field and no response is agy reporting a
    # failure, not an answer: passing it through printed {"status":"ERROR",...} as
    # the review with exit 0. A receipt line, a DesignPacket or a finding array has
    # neither key and still passes through unchanged.
    if isinstance(j, dict) and ("status" in j or "error" in j):
        sys.exit(3)
    sys.exit(4)
r = j["response"]
# An envelope that reports a failure is not an answer even when it carries text:
# {"status":"ERROR","response":"quota exceeded"} printed "quota exceeded" as the
# review with exit 0 (found by review of the first fix). Only SUCCESS passes.
st = j.get("status")
if j.get("error") or (isinstance(st, str) and st.upper() != "SUCCESS"):
    sys.stderr.write("agyask: agy reported status=%r error=%r — not an answer.\n" % (st, j.get("error")))
    sys.exit(3)
if os.environ.get("AGY_SCHEMA"):
    so = j.get("structured_output")
    if not isinstance(so, (dict, list)):
        sys.stderr.write("agyask: AGY_SCHEMA set but the envelope carries no structured_output — agy did not honour the schema.\n")
        sys.exit(3)
    r = json.dumps(so, ensure_ascii=False)   # one line, clean JSON; `response` is a fenced blob under a schema
if not r.strip():
    sys.exit(5)                         # envelope, empty answer -> treat as no output
sys.stdout.write(r)
u = j.get("usage")
u = u.get("total_tokens") if isinstance(u, dict) else None   # usage may be any type
ok = isinstance(u, int) and not isinstance(u, bool)
sys.stderr.write("BABEL_USAGE {\"provider\":\"agy\",\"total_tokens\":%s}\n" % (u if ok else "null"))
'); then _prc=0; else _prc=$?; fi
  case "$_prc" in
    0) out=$_resp ;;
    4) : ;;                             # not an envelope: $out already is the answer
    5) out="" ;;                        # falls through to the empty-output path below
    *) printf 'agyask: agy JSON mode produced output that is neither a result envelope nor valid finding-jsonl; refusing to print it.\n' >&2
       # `if`, not `[ ] && exit`: under set -e a failing test in a bare && list
       # ends the script with 1, which is neither agy's status nor ours.
       if [ "$rc" -ne 0 ]; then exit "$rc"; fi   # keep agy's own status when it had one
       exit 3 ;;
  esac
fi
if [ -n "$out" ]; then
  printf '%s\n' "$out"
  # Non-zero with output means agy died part-way through its answer: every line
  # of a half-written finding-jsonl is still valid JSON on its own, so a format
  # check downstream cannot tell it from a complete review. The text is kept
  # (unlike the watchdog-kill branch, where the budget is provably gone), but
  # the exit status must not claim success — a caller that ignores it and
  # commits the round records unreviewed code as reviewed.
  if [ "$rc" -ne 0 ]; then
    printf 'agyask: agy exited %s after writing output — treat this answer as possibly truncated, not a completed review.\n' "$rc" >&2
    exit "$rc"
  fi
  exit 0
fi
# The PTY fallback exists for the stdout-flushing bug, not for permission
# denials: a denied tool aborts the run identically on both paths, so retrying
# only burns ~30s and prints the same error twice. Fail fast with the fix instead.
if grep -q 'headless mode cannot prompt for' "$agy_err"; then
  printf 'agyask: agy auto-denied a tool permission and produced nothing. Make the prompt self-contained (leave AGY_TOOLS unset), or add the allow-rule the message names to ~/.gemini/antigravity-cli/settings.json.\n' >&2
  exit 2
fi
[ "$rc" -eq 0 ] || printf 'agyask: direct agy call exited %s with no output — trying the PTY fallback.\n' "$rc" >&2

# Empty output. Fall back to the PTY path only with enough budget left for it to
# finish — otherwise the caller's Bash timeout kills a fallback that never had a
# chance, and the failure looks like agy hanging rather than running out of time.
# Elapsed is the larger of what the wall clock says and what the watchdog actually
# counted. `date` can step backwards, which alone made the elapsed term negative
# and handed the fallback *more* than the caller's total budget; clamping to the
# full budget was not enough either, since the direct phase had already spent most
# of it and the two phases together came to roughly twice what was asked for.
_elapsed=$(( $(date +%s) - started ))
[ "$ticks" -gt "$_elapsed" ] && _elapsed=$ticks
[ "$_elapsed" -lt 0 ] && _elapsed=0
remaining=$(( budget_secs - _elapsed ))
if [ "$remaining" -lt 30 ]; then
  printf 'agyask: no output and only %ss of the %ss budget left — not starting the PTY fallback.\n' \
    "$remaining" "$budget_secs" >&2
  exit 2
fi
# The wrapper needs ptyprocess, which PEP 668 blocks from a system pip. install.sh
# puts it in a venv outside the skills tree, since installing wipes and recopies that.
# Both layouts: install.sh creates Scripts/python.exe under Windows and
# bin/python3 elsewhere. Checking only the POSIX path sent every Windows run to
# the system interpreter, where the PTY package is not installed.
PY="$HOME/.local/share/babel/agy-venv/bin/python3"
[ -x "$PY" ] || PY="$HOME/.local/share/babel/agy-venv/Scripts/python.exe"
[ -x "$PY" ] || PY=python3
rm -f "$agy_err"
# `--` first: the wrapper takes the prompt as a positional argparse argument, so a
# payload that begins with a dash is parsed as wrapper options — and a payload of
# exactly `--help` printed help to stdout and exited 0, which the caller would
# have ingested as agy's answer.
# `--agy-path "$AGY_BIN"`: without it the wrapper resolves agy itself, and on POSIX
# its resolution order treats PATH as authoritative — reopening, on the fallback
# path only, exactly the planted-binary hole the AGY_BIN loop above closes. Both
# paths must pin the same executable.
# `--add-dir "$AGY_DIR"`: the same workspace rule as the direct path — an empty
# directory unless AGY_TOOLS=1 — or the fallback would reopen the tree the direct
# path just closed. The PTY path cannot remove that directory afterwards (exec
# never returns), so a fallback run leaves one empty temp dir behind.
exec "$PY" "$HOME/.claude/skills/agy/agy_pty_wrapper.py" --agy-path "$AGY_BIN" --add-dir "$AGY_DIR" --timeout "$remaining" -- "$prompt"
