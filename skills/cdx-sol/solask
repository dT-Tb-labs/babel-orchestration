#!/bin/sh
# solask / astraask — the normal way to call the Codex channel from Claude Code.
#
# ONE script, TWO command names. The name it is invoked as picks the model:
#
#   solask    -> gpt-6-sol
#   astraask  -> gpt-6-astra   (skills/cdx-astra; ~/.local/bin/astraask is a symlink here)
#
# Installed to ~/.local/bin by install.sh. Four things it guarantees:
#
# 1. The job can write its state. codex-companion's default state root
#    (~/.claude/plugins/data) is on the sandbox deny list, so a plain call dies
#    with "EPERM: operation not permitted, open .../jobs/task-*.log" before the
#    model is ever reached. CLAUDE_PLUGIN_DATA moves it somewhere writable.
#    Both names share one state root on purpose: --attach works across them.
#
# 2. It has a distinct command name, so sandbox.excludedCommands can send it
#    outside the sandbox. cdx-sol shells out to sandbox-exec for its own read-only
#    sandbox, and that cannot nest inside Claude Code's sandbox — every workspace
#    read fails with "sandbox_apply: Operation not permitted". The model's own
#    read-only sandbox still applies; what moves is only where the wrapper runs.
#
# 3. The model is PINNED per command name. Without the pin, codex inherits
#    ~/.codex/config.toml — so editing one line there silently changed which model
#    every "SOL" call had been talking to, with nothing in the output saying so.
#
# Runs outside the Claude Code sandbox via sandbox.excludedCommands
# ("solask" + "solask *" + "astraask" + "astraask *"). Renaming this script, or
# the symlink, means updating that list. See cdx-sol/SKILL.md and cdx-astra/SKILL.md.
#
# Leading --out <file> / --err <file> replace shell redirects. excludedCommands only
# matches a PLAIN command (measured 2026-09-27: a redirect, env prefix, $VAR or
# $(...) each stops the match and the call dies inside the sandbox with EPERM), so
# a babel dispatch must be `solask --out a --err b --tier normal --cwd /abs/repo "…"`.
set -eu

while [ $# -gt 0 ]; do
  case $1 in
    --out|--err)
      [ $# -ge 2 ] || { printf '%s: %s needs a value.\n' "${0##*/}" "$1" >&2; exit 3; }
      if [ "$1" = --out ]; then exec >"$2"; else exec 2>"$2"; fi
      shift 2 ;;
    *) break ;;
  esac
done

# Inside the Claude Code sandbox cdx-sol cannot write its state root or nest its
# own sandbox-exec, so the call is certain to fail. pgrep failing to read the
# process table is the measured sandbox signature (agyask uses the same test).
if command -v pgrep >/dev/null 2>&1 && ! pgrep -P $$ >/dev/null 2>&1 && ! pgrep -l -P 1 >/dev/null 2>&1; then
  printf '%s: running INSIDE the Claude Code sandbox, where this channel cannot work. The call did not match sandbox.excludedCommands: invoke it as one plain command — no env prefix, redirect, pipe, $(...), variable or `cd &&`. Use --out/--err and a literal --cwd path instead.\n' "${0##*/}" >&2
  exit 3
fi

case "${0##*/}" in
  solask)   MODEL=gpt-6-sol ;;
  astraask) MODEL=gpt-6-astra ;;
  *)
    printf '%s: not a known channel name (solask|astraask). Refusing: the model pin is chosen by this name.\n' "${0##*/}" >&2
    exit 3
    ;;
esac

# Lean app-server: cdx-sol/bin/codex adds -c/--disable overrides (no plugins, MCP,
# browser/computer-use/image tools; verbosity low; no reasoning summary) to the
# app-server the companion spawns via PATH. Both lines below exist so that spawn
# actually happens here, not somewhere reused:
# - the state root is FORCED, not defaulted: the companion reuses the broker
#   recorded under it, and a broker started elsewhere (the codex plugin's own
#   root, which Claude Code exports as CLAUDE_PLUGIN_DATA) runs a full app-server.
#   A new directory name, so brokers started before the overrides are not reused.
# - an inherited broker endpoint is dropped for the same reason.
CLAUDE_PLUGIN_DATA=$HOME/.local/state/babel/codex-lean
export CLAUDE_PLUGIN_DATA
mkdir -p "$CLAUDE_PLUGIN_DATA"
unset CODEX_COMPANION_APP_SERVER_ENDPOINT
PATH=$HOME/.claude/skills/cdx-sol/bin:$PATH
export PATH

# This shim is sandbox-excluded, so anything it executes runs with the user's full
# access. Three consequences, all of which cost nothing to close:
#
# 1. CDX_SOL_COMPANION makes cdx-sol.mjs execute an arbitrary path. Reaching it
#    through this shim turns "can run a sandboxed command" into "can run anything
#    unsandboxed", so the override is refused here. Set it on a direct
#    `node .../cdx-sol.mjs` call instead — that one is inside the sandbox and goes
#    through the normal permission prompt.
# 2. Write mode is documented as a direct `node .../cdx-sol.mjs --allow-write` call
#    (cdx-sol/SKILL.md). Accepting the flag here let it inherit the exclusion with
#    nothing but prose asking for user approval first.
# 3. --model is refused for the same reason the pin exists: cdx-sol.mjs takes the
#    last --model on the line, so a caller-supplied one would silently win and the
#    channel name would stop describing what answered.
#
# The scan below is a fast, legible refusal — it is NOT the enforcement point, and
# it cannot be. It does not know which flags take VALUES, so it stops at the first
# bare `--` while cdx-sol.mjs consumes that same `--` as (say) --cwd's value and
# keeps parsing: `--cwd -- --allow-write hi` slipped straight past this loop, and
# did so long before a model pin existed. The two exports below are what actually
# holds; cdx-sol.mjs applies them AFTER parsing, where the values are final.
if [ -n "${CDX_SOL_COMPANION:-}" ]; then
  printf '%s: CDX_SOL_COMPANION is set. This shim runs outside the Claude Code sandbox and will not execute an overridden companion path. Call cdx-sol.mjs directly if you mean it.\n' "${0##*/}" >&2
  exit 3
fi
for _a in "$@"; do
  [ "$_a" = "--" ] && break
  if [ "$_a" = "--allow-write" ]; then
    printf '%s: --allow-write is not accepted here (this shim is sandbox-excluded). Run write mode explicitly, after the user approves it:\n  node "$HOME/.claude/skills/cdx-sol/cdx-sol.mjs" --model %s --allow-write --cwd <repo> "<prompt>"\n' "${0##*/}" "$MODEL" >&2
    exit 3
  fi
  case "$_a" in
    --model|--model=*)
      printf '%s: --model is not accepted here. The model is pinned to "%s" by the command name you used (solask|astraask). Call cdx-sol.mjs directly to choose a different one.\n' "${0##*/}" "$MODEL" >&2
      exit 3
      ;;
  esac
done

# Resolve node the way agyask resolves agy: PATH is not searched, because a `node`
# planted earlier on PATH would execute unsandboxed here.
NODE_BIN=""
for _c in /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node "$HOME/.local/bin/node"; do
  [ -x "$_c" ] && { NODE_BIN=$_c; break; }
done
[ -n "$NODE_BIN" ] || { printf '%s: no node found in a trusted location (/opt/homebrew/bin, /usr/local/bin, /usr/bin, ~/.local/bin). PATH is deliberately not searched: this shim runs outside the sandbox.\n' "${0##*/}" >&2; exit 3; }

CDX_SOL_PIN_MODEL="$MODEL"
CDX_SOL_NO_WRITE=1
export CDX_SOL_PIN_MODEL CDX_SOL_NO_WRITE

exec "$NODE_BIN" "$HOME/.claude/skills/cdx-sol/cdx-sol.mjs" --model "$MODEL" "$@"
